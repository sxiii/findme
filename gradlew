##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh does
#       not find so, but you have some other compatible shell such as ksh or
#       bash, then change the shebang line to use the other shell, or create a
#       wrapper script and invoke it instead of calling this script directly.
#
#   (2) The slurped sed script (`transformant` variable)
#       checks for line endings and converts them to Unix format before anything else does.
#
#   (3) Put the "JAVA_HOME" variable in your environment. It is used by this
#       script to determine which java executable to use when running Gradle.
#       By default the value of "JAVA_HOME" will be used, but you can use
#       "JAVA_HOME_MODULE" if you need to override it for a specific gradle
#       module.
#
#   (4) Each time a new Gradle release is published, the gradle-wrapper.jar
#       binary is updated; if you manually edit the wrapper script, it will
#       stop working as expected.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}    # leaves a trailing slash where not needed
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in                                #(
        /*)   app_path=$link ;;
        *)    app_path=$APP_HOME$link ;;
    esac
done

APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}
export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 $JAVA_TOOL_OPTIONS"

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='" -Xmx64m" -Xms64m"

# Collect all arguments for the java command;
#   * "$DEFAULT_JVM_OPTS",
#   * the user-provided arguments,
#   * and the defaults,
#   * but skip the last arg if it's just '--' to avoid the 'spurious option conversions' in -ea.

jars =""
optional_jars=""
for arg do
    case $arg in                                #(
        --)   shift; break ;;
        -*)   false ;;
        *)    break ;;
    esac
done

case "$( uname )" in                #(
  Darwin* )         JAVA_HOME=$( /usr/libexec/java_home ) ;;
  MINGW* )          JAVA_HOME="$( cd "$JAVA_HOME" && pwd -P )"
                    PATH="$JAVA_HOME/bin:$PATH"
                    ;;
  MSYS* )           JAVA_HOME="$( cd "$JAVA_HOME" && pwd -P )"
                    PATH="$JAVA_HOME/bin:$PATH"
                    ;;
esac

if [ ! -x "$JAVA_HOME/bin/java" ] && [ ! -x "$JAVA_HOME/bin/java.exe" ]; then
    echo "ERROR: JAVA_HOME is not set to a valid directory. We cannot execute $JAVA_CMD" >&2
    exit 1
fi

if [ -z "$JAVA_HOME" ] ; then
    echo "Warning: JAVA_HOME environment variable is not set."
fi

JAVA_EXE="$JAVA_HOME/bin/java"
export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 $JAVA_TOOL_OPTIONS"

exec "$JAVA_EXE" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
